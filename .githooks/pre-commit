#!/bin/sh
# Blocks a commit that adds an audio file with no licence entry in tools/audio_allowlist.json.
# Enable once per clone:  git config core.hooksPath .githooks
PY=$(command -v python3 || command -v python || command -v py)
if [ -n "$PY" ]; then
	"$PY" tools/check_audio_licences.py --staged || exit 1
else
	echo "pre-commit: no python found, skipping the audio licence check"
fi
