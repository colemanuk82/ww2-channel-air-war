; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WW2 Channel Air War"
config/version="1.3"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[audio]

general/text_to_speech=true

[autoload]

WorldCoords="*res://scripts/world_coords.gd"
GameState="*res://scripts/game_state.gd"
TimeOfDay="*res://scripts/time_of_day.gd"
WeatherManager="*res://scripts/weather_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
SaveSystem="*res://scripts/save_system.gd"
FX="*res://scripts/effects/fx.gd"
Weapons="*res://scripts/weapons/weapon_world.gd"
Radio="*res://scripts/radio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

